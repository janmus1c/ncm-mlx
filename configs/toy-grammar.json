{
  "name": "toy-grammar",
  "out_dir": "artifacts/toy-grammar",
  "data": {
    "corpus": "toy-grammar",
    "seq_len": 32,
    "n_train": 4000,
    "n_val": 500,
    "split_seed": 0
  },
  "codec": {
    "dim": 128,
    "n_head": 4,
    "enc_layers": 2,
    "dec_layers": 2,
    "dropout": 0.1,
    "levels": [
      1,
      2,
      4,
      8,
      16,
      32
    ],
    "codebook_sizes": [
      128,
      128,
      128,
      128,
      128,
      128
    ],
    "decay": 0.95,
    "epsilon": 1e-05,
    "commitment": 0.25,
    "quant_resi_ratio": 0.5,
    "restart_threshold": 0.05,
    "fine_drop_prob": 0.5,
    "fine_drop_min_keep": 1
  },
  "generator": {
    "n_embd": 256,
    "n_layer": 6,
    "n_head": 4,
    "dropout": 0.1,
    "prefix_len": 1,
    "rope_base": 10000.0
  },
  "train": {
    "seed": 0,
    "codec_steps": 3000,
    "codec_lr": 0.001,
    "generator_steps": 4000,
    "generator_lr": 0.0006,
    "batch_size": 128,
    "warmup": 100,
    "weight_decay": 0.01,
    "log_every": 250
  }
}
