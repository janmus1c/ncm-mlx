    "codec": {"steps": 700, "batch_size": 256, "lr": 5e-4, "lr_floor": 5e-5, "warmup": 100, "beta2": 0.95,
              "weight_decay": 0.01, "max_minutes": 3.5},
    "generator": {"steps": 200, "batch_size": 64, "lr": 5e-4, "lr_floor": 5e-5, "warmup": 20, "beta2": 0.95,
                  "weight_decay": 0.1, "max_minutes": 4.5},
    "ar": {"steps": 400, "batch_size": 128, "lr": 5e-4, "lr_floor": 5e-5, "warmup": 20, "beta2": 0.95,
           "weight_decay": 0.1, "max_minutes": 2}
  }
}
