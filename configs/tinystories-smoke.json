{
  "name": "tinystories-smoke",
  "out_dir": "artifacts/tinystories-smoke",
  "data": {"seq_len": 128, "val_rows": 1024, "unigram_rows": 50000},
  "codec": {"dim": 256, "n_head": 4,
            "codebook_sizes": [2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048],
            "dropout": 0.3, "decay": 0.95, "fine_drop_prob": 0.5, "restart_threshold": 0.01},
  "generator": {"n_layer": 6, "n_head": 6, "dim": 384, "dropout": 0.1, "corrupt_first": 0.75, "corrupt_last": 0.25},
  "train": {
